---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Photo from "./Photo.astro";
import Logo from "./Logo.astro";
import BookingRequest from "./islands/BookingRequest";
import Gallery, { type GalleryImage } from "./islands/Gallery";
import CopyButton from "./islands/CopyButton";
import MapEmbed from "./islands/MapEmbed";
import MobileBookBar from "./islands/MobileBookBar";
import { copy, fill, type Lang } from "../i18n/copy";
import { path } from "../i18n/paths";
import { site, plans, fromPrice, yen, mapsUrl, mapsEmbed, instagramUrl, instagramDm } from "../data/site";

import shopDusk from "../assets/images/01-takase-river-dusk.jpg";
import willow from "../assets/images/04a-tatami.jpg";
import roundWindow from "../assets/images/04b-tokonoma.jpg";
import kettle from "../assets/images/04c-chabana.jpg";
import tins from "../assets/images/07-bowl-whisk.jpg";
import summerShop from "../assets/images/08-signature.jpg";
import room from "../assets/images/09-ippuku.jpg";
import serving from "../assets/images/moment-01.jpg";
import host from "../assets/images/moment-02.jpg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const priceFrom = yen(fromPrice);

// ── gallery images, pre-sized for the island ──
const shots: [ImageMetadata, keyof typeof t.room.photos, string][] = [
  [room, "ippuku", "col-span-2 row-span-2"],
  [roundWindow, "tokonoma", "row-span-2"],
  [kettle, "kettle", ""],
  [tins, "tins", ""],
  [serving, "moment1", "row-span-2"],
  [summerShop, "signature", "row-span-2"],
  [host, "moment2", "row-span-2"],
  [willow, "tatami", "row-span-2"],
];
const gallery: GalleryImage[] = await Promise.all(
  shots.map(async ([src, key, span]) => {
    const thumb = await getImage({ src, widths: [400, 800], format: "webp" });
    const full = await getImage({ src, widths: [800, 1200, 1600], format: "webp" });
    return {
      thumb: { src: thumb.src, srcset: thumb.srcSet.attribute },
      full: { src: full.src, srcset: full.srcSet.attribute },
      alt: t.room.photos[key],
      width: src.width,
      height: src.height,
      span,
    };
  }),
);

const planCards = plans.map((p) => ({ ...p, ...t.plans.items[p.id] }));
const marks = ["一", "二", "三", "四", "五"];
const isJa = lang === "ja";
---

<main>
  <!-- ═══ HERO ═══ -->
  <section id="top" class="relative overflow-hidden">
    <div class="container-x grid items-center gap-10 pt-8 pb-16 md:pt-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:pt-16 lg:pb-24">
      <div class="max-w-xl">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1
          class="h-display mt-6 text-[clamp(2.6rem,6.2vw,4.75rem)] [:lang(ja)_&]:text-[clamp(2.1rem,5vw,3.6rem)]"
        >
          {t.hero.title[0]}<br />
          <span class="text-matcha italic [:lang(ja)_&]:not-italic">{t.hero.title[1]}</span>
        </h1>
        <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-ink-2">{t.hero.lead}</p>
        <ul class="mt-8 flex flex-wrap gap-2">
          {
            t.hero.facts.map((f) => (
              <li class="rounded-full border border-line bg-paper-2/60 px-3.5 py-1.5 text-sm text-ink-2">
                {fill(f, { price: priceFrom })}
              </li>
            ))
          }
        </ul>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#book" class="btn btn-primary">{t.hero.primary} <span aria-hidden="true">→</span></a>
          <a href="#plans" class="btn btn-ghost text-matcha">{t.hero.secondary}</a>
        </div>
      </div>

      <div class="relative">
        <Photo
          src={shopDusk}
          alt={t.hero.photoAlt}
          priority
          sizes="(min-width: 1024px) 45vw, 100vw"
          class="aspect-[4/5] rounded-[1.25rem] sm:aspect-[5/4] lg:aspect-[4/5]"
          position="50% 60%"
        />
        <Photo
          src={serving}
          alt={t.room.photos.moment1}
          sizes="200px"
          class="absolute -bottom-6 -left-4 hidden aspect-[3/4] w-[34%] rounded-xl border-4 border-paper shadow-[0_12px_32px_rgb(29_35_31/0.18)] sm:block lg:-left-10"
        />
      </div>
    </div>
  </section>

  <!-- ═══ WHY ═══ -->
  <section class="border-y border-line bg-paper-2/70">
    <div class="container-x py-16 md:py-20">
      <div class="grid gap-10 lg:grid-cols-[1fr_2.4fr] lg:gap-16">
        <div data-reveal>
          <p class="eyebrow">{t.why.eyebrow}</p>
          <h2 class="h-display mt-4 text-4xl md:text-5xl [:lang(ja)_&]:text-3xl">{t.why.title}</h2>
        </div>
        <ul class="grid gap-8 sm:grid-cols-3" data-reveal>
          {
            t.why.items.map((it, i) => (
              <li>
                <span class="font-mincho text-lg text-matcha" aria-hidden="true">{marks[i]}</span>
                <h3 class="mt-2 text-lg font-medium">{it.title}</h3>
                <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">{it.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ PLANS ═══ -->
  <section id="plans" class="py-20 md:py-28">
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{t.plans.eyebrow}</p>
        <h2 class="h-display mt-4 text-4xl md:text-[3.25rem] [:lang(ja)_&]:text-[2.25rem]">{t.plans.title}</h2>
        <p class="mt-4 text-lg text-ink-2">{t.plans.lead}</p>
      </div>

      <ul class="mt-12 grid gap-5 lg:grid-cols-3" data-reveal>
        {
          planCards.map((p) => {
            const featured = p.id === "signature";
            return (
              <li
                class:list={[
                  "relative flex flex-col rounded-2xl p-6 sm:p-8",
                  featured ? "bg-matcha text-paper shadow-[0_18px_40px_rgb(17_74_55/0.25)]" : "border border-line bg-[#fffdf9]",
                ]}
              >
                {featured && (
                  <span class="absolute -top-3 left-6 rounded-full bg-[#e8dcc0] px-3 py-1 text-xs font-medium text-matcha-2 sm:left-8">
                    {t.plans.recommended}
                  </span>
                )}
                <p class:list={["text-sm", featured ? "text-paper/75" : "text-muted"]}>{p.kind}</p>
                <h3 class="mt-2 flex items-baseline gap-3">
                  <span class="font-display text-[2.4rem] leading-none font-semibold">{p.name}</span>
                  <span class:list={["font-mincho", featured ? "text-paper/70" : "text-muted"]}>{p.ja}</span>
                </h3>
                <p class="mt-5 flex items-baseline gap-2">
                  <span class="font-display text-[2rem] leading-none font-semibold tabular-nums">{yen(p.price)}</span>
                  <span class:list={["text-sm", featured ? "text-paper/75" : "text-muted"]}>
                    {t.plans.perPerson} · {fill(t.plans.minutes, { n: p.minutes })}
                  </span>
                </p>
                <p class:list={["mt-5 leading-relaxed", featured ? "text-paper/90" : "text-ink-2"]}>{p.summary}</p>
                <h4 class:list={["mt-6 text-xs font-medium tracking-[0.16em] uppercase", featured ? "text-paper/80" : "text-muted"]}>
                  {t.plans.includes}
                </h4>
                <ul class="mt-3 mb-8 space-y-2 text-[0.9375rem]">
                  {p.includes.map((inc) => (
                    <li class="flex gap-3">
                      <svg viewBox="0 0 20 20" class:list={["mt-1 size-4 shrink-0", featured ? "text-[#cfe0b9]" : "text-leaf"]} fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path d="m4 10.5 4 4 8-9" />
                      </svg>
                      <span>{inc}</span>
                    </li>
                  ))}
                </ul>
                <a href={`#book-${p.id}`} class:list={["btn mt-auto w-full", featured ? "btn-light" : "btn-ghost text-matcha"]}>
                  {t.plans.cta}
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="mt-6 grid gap-6 rounded-2xl border border-dashed border-[#c9bea9] p-6 sm:p-8 md:grid-cols-[1fr_auto] md:items-center" data-reveal>
        <div>
          <h3 class="font-display text-2xl font-semibold [:lang(ja)_&]:font-mincho [:lang(ja)_&]:text-xl">{t.plans.offsite.title}</h3>
          <p class="mt-2 max-w-3xl text-ink-2">{t.plans.offsite.body}</p>
        </div>
        <a href={path(lang, "offsite")} class="btn btn-ghost text-matcha">
          {t.plans.offsite.cta} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ SESSION ═══ -->
  <section id="session" class="bg-paper-2/70 py-20 md:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <p class="eyebrow">{t.flow.eyebrow}</p>
        <h2 class="h-display mt-4 text-4xl md:text-[3.25rem] [:lang(ja)_&]:text-[2.25rem]">{t.flow.title}</h2>
        <Photo
          src={serving}
          alt={t.room.photos.moment1}
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="mt-8 aspect-[4/3] rounded-2xl lg:aspect-[5/4]"
          position="50% 35%"
        />
      </div>
      <div data-reveal>
        <ol class="relative">
          {
            t.flow.steps.map((s, i) => (
              <li class="relative grid grid-cols-[3rem_1fr] gap-4 pb-10 last:pb-0">
                {i < t.flow.steps.length - 1 && (
                  <span class="absolute top-12 bottom-0 left-6 w-px bg-line" aria-hidden="true" />
                )}
                <span class="relative grid size-12 place-items-center rounded-full border border-line bg-paper font-mincho text-lg text-matcha">
                  {marks[i]}
                </span>
                <div class="pt-2">
                  <h3 class="text-xl font-medium">{s.title}</h3>
                  <p class="mt-2 leading-relaxed text-ink-2">{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="mt-10 flex items-center gap-3 rounded-xl bg-paper px-5 py-4 text-ink-2">
          <svg viewBox="0 0 24 24" class="size-5 shrink-0 text-matcha" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" />
          </svg>
          {t.flow.note}
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ ROOM ═══ -->
  <section id="room" class="py-20 md:py-28">
    <div class="container-x">
      <div class="grid gap-4 md:grid-cols-[1fr_1fr] md:items-end" data-reveal>
        <div>
          <p class="eyebrow">{t.room.eyebrow}</p>
          <h2 class="h-display mt-4 text-4xl md:text-[3.25rem] [:lang(ja)_&]:text-[2.25rem]">{t.room.title}</h2>
        </div>
        <p class="max-w-md text-lg text-ink-2 md:justify-self-end">{t.room.lead}</p>
      </div>
      <div class="mt-10" data-reveal>
        <Gallery client:visible images={gallery} labels={t.room} />
      </div>
    </div>
  </section>

  <!-- ═══ STORY ═══ -->
  <section class="bg-matcha text-paper">
    <div class="container-x grid items-center gap-10 py-20 md:grid-cols-[1.4fr_1fr] md:py-24 lg:gap-20">
      <div data-reveal>
        <p class="eyebrow text-[#cfe0b9]">{t.story.eyebrow}</p>
        <blockquote class="mt-6 font-display text-[clamp(1.8rem,3.4vw,2.75rem)] leading-[1.25] italic [:lang(ja)_&]:font-mincho [:lang(ja)_&]:text-[clamp(1.4rem,2.6vw,2rem)] [:lang(ja)_&]:leading-[1.7] [:lang(ja)_&]:not-italic">
          “{t.story.quote}”
        </blockquote>
        <p class="mt-6 max-w-xl text-paper/80">{t.story.body}</p>
        <a href={path(lang, "about")} class="btn btn-outline-light mt-8">{t.story.cta} <span aria-hidden="true">→</span></a>
      </div>
      <Photo
        src={host}
        alt={t.room.photos.moment2}
        sizes="(min-width: 768px) 35vw, 100vw"
        class="aspect-[4/5] rounded-2xl"
        data-reveal
      />
    </div>
  </section>

  <!-- ═══ BOOK ═══ -->
  <section id="book" class="scroll-mt-16 py-20 md:py-28">
    <!-- targets for plan buttons so they scroll here even without JS -->
    {plans.map((p) => <span id={`book-${p.id}`} class="relative -top-24 block" aria-hidden="true" />)}
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">{t.book.eyebrow}</p>
        <h2 class="h-display mt-4 text-4xl md:text-[3.25rem] [:lang(ja)_&]:text-[2.25rem]">{t.book.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-2">{t.book.lead}</p>
        <div class="mt-10 border-t border-line pt-6">
          <p class="text-sm text-muted">{t.book.or}</p>
          <ul class="mt-3 space-y-2">
            <li>
              <a class="link" href={instagramUrl} target="_blank" rel="noopener">Instagram · @{site.instagram}</a>
            </li>
            <li><a class="link break-all" href={`mailto:${site.email}`}>{site.email}</a></li>
          </ul>
        </div>
      </div>
      <div class="rounded-3xl border border-line bg-[#fbf8f2] p-5 shadow-[0_10px_40px_rgb(29_35_31/0.06)] sm:p-8" data-reveal>
        <BookingRequest
          client:visible
          t={t.book}
          lang={lang}
          plans={planCards.map(({ id, name, ja, price, minutes, kind }) => ({ id, name, ja, price, minutes, kind }))}
          email={site.email}
          instagramDm={instagramDm}
          maxGuests={site.maxGuests}
          minutesLabel={t.plans.minutes}
        />
      </div>
    </div>
  </section>

  <!-- ═══ VISIT ═══ -->
  <section id="visit" class="border-t border-line bg-paper-2/70 py-20 md:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">{t.visit.eyebrow}</p>
        <h2 class="h-display mt-4 text-4xl md:text-[3.25rem] [:lang(ja)_&]:text-[2.25rem]">{t.visit.title}</h2>

        <dl class="mt-10 grid gap-8 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-medium tracking-[0.16em] text-muted uppercase">{t.visit.address}</dt>
            <dd class="mt-2 leading-relaxed">
              {(isJa ? site.address.ja : site.address.en).map((l) => <span class="block">{l}</span>)}
            </dd>
          </div>
          {
            !isJa && (
              <div>
                <dt class="text-xs font-medium tracking-[0.16em] text-muted uppercase">{t.visit.addressJa}</dt>
                <dd class="mt-2 font-mincho leading-relaxed" lang="ja">
                  {site.address.ja.map((l) => <span class="block">{l}</span>)}
                </dd>
              </div>
            )
          }
          <div class="sm:col-span-2">
            <dt class="text-xs font-medium tracking-[0.16em] text-muted uppercase">{t.visit.stations}</dt>
            <dd class="mt-3">
              <ul class="divide-y divide-line rounded-xl border border-line bg-paper">
                {
                  t.visit.stationList.map((s) => (
                    <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-4 py-3">
                      <span>
                        <span class="font-medium">{s.name}</span>
                        <span class="ml-2 text-sm text-muted">{s.line} · {s.exit}</span>
                      </span>
                      <span class="text-sm text-matcha">{s.walk}</span>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
        </dl>

        <p class="mt-8 flex gap-3 text-ink-2">
          <Logo class="mt-0.5 size-5 shrink-0" />
          {t.visit.look}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={mapsUrl} target="_blank" rel="noopener" class="btn btn-primary">{t.visit.maps} <span aria-hidden="true">↗</span></a>
          <CopyButton client:visible text={site.address.taxi} label={t.visit.copy} done={t.visit.copied} />
        </div>
      </div>

      <div class="aspect-[4/3] overflow-hidden rounded-2xl border border-line lg:aspect-auto lg:min-h-[28rem]" data-reveal>
        <MapEmbed client:visible src={mapsEmbed} title={t.visit.mapTitle} label={t.visit.loadMap} note={t.visit.mapNote} />
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section id="faq" class="py-20 md:py-28">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.8fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">{t.faq.eyebrow}</p>
        <h2 class="h-display mt-4 text-4xl md:text-[3.25rem] [:lang(ja)_&]:text-[2.25rem]">{t.faq.title}</h2>
      </div>
      <div class="divide-y divide-line border-y border-line" data-reveal>
        {
          t.faq.items.map((f) => (
            <details class="group py-1">
              <summary class="flex items-center justify-between gap-6 py-4 text-lg font-medium hover:text-matcha">
                {f.q}
                <span class="faq-icon grid size-8 shrink-0 place-items-center rounded-full border border-line text-xl leading-none text-matcha transition-transform duration-300" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="pb-5 pr-12 leading-relaxed text-ink-2">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <MobileBookBar client:idle href="#book" label={t.hero.primary} price={fill(t.hero.facts[2], { price: priceFrom })} />
</main>
