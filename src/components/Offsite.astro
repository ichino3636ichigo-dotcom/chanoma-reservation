---
import Photo from "./Photo.astro";
import OffsiteRequest from "./islands/OffsiteRequest";
import { offsite } from "../i18n/offsite";
import { copy, type Lang } from "../i18n/copy";
import { path } from "../i18n/paths";
import { site, instagramUrl, instagramDm } from "../data/site";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Gallery, { type GalleryImage } from "./islands/Gallery";
import ushareTalk from "../assets/images/offsite/ushare-talk.jpg";
import ushareServing from "../assets/images/offsite/ushare-serving.jpg";
import ushareBowl from "../assets/images/offsite/ushare-bowl.jpg";
import ushareTray from "../assets/images/offsite/ushare-tray.jpg";
import ushareHost from "../assets/images/offsite/ushare-host.jpg";
import ushareFlowers from "../assets/images/offsite/ushare-flowers.jpg";
import liliTearoom from "../assets/images/offsite/corporate-tearoom.jpg";
import liliGuests from "../assets/images/offsite/corporate-guests.jpg";
import liliTemae from "../assets/images/offsite/corporate-temae.jpg";
import liliTokonoma from "../assets/images/offsite/corporate-tokonoma.jpg";
import cuhkTalk from "../assets/images/offsite/cuhk-talk.jpg";
import cuhkGroup from "../assets/images/offsite/cuhk-group.jpg";
import ykRoom from "../assets/images/offsite/yokohama-room.jpg";
import ykTemae from "../assets/images/offsite/yokohama-temae.jpg";
import ykGroup from "../assets/images/offsite/yokohama-group.jpg";
import ykGuest from "../assets/images/offsite/yokohama-guest-portrait.jpg";
import ykChat from "../assets/images/offsite/yokohama-chat.jpg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const o = offsite[lang];
const t = copy[lang];
const marks = ["一", "二", "三", "四", "五", "六", "七", "八"];
const isJa = lang === "ja";

// one photo per track-record entry
const workPhotos: Record<string, { src: ImageMetadata; alt: string }> = {
  lili: { src: liliTearoom, alt: isJa ? "企業研修で、茶室でお点前をする亭主" : "The host performing temae in a tatami tea room for a company training" },
  ushare: { src: ushareTalk, alt: isJa ? "U Share のワークショップで茶道について話す亭主" : "The host introducing tea ceremony at the U Share workshop" },
  yokohama: { src: ykTemae, alt: isJa ? "白雲亭で、立礼卓を使ってお点前をする亭主" : "The host preparing tea at a ryūrei table at Hakuun-tei" },
  cuhk: { src: cuhkTalk, alt: isJa ? "香港中文大学で「清寂」について話す亭主" : "The host explaining sei-jaku (purity and tranquillity) at CUHK" },
};

// gallery from past sessions
const shots: [ImageMetadata, string, string, string][] = [
  [ykGroup, "三溪園 白雲亭での集合写真", "Group photo at Hakuun-tei, Sankeien", "col-span-2 row-span-2"],
  [ushareBowl, "U Share のワークショップで点てた一服", "A bowl of matcha whisked at the U Share workshop", "row-span-2"],
  [liliTokonoma, "研修会場の茶室の床の間", "The alcove of the tea room used for the training", ""],
  [ushareTray, "盆略点前の道具と干菓子", "Tray-style tea tools and dry sweets", ""],
  [ykGuest, "立礼の席で一服をいただく参加者", "A guest enjoying a bowl at the ryūrei table", "row-span-2"],
  [liliTemae, "茶室でお点前をする亭主", "The host performing temae in the tea room", "row-span-2"],
  [ykChat, "参加者と写真を見ながら話す亭主", "The host looking at photos with guests", "row-span-2"],
  [ushareServing, "U Share のワークショップで参加者にお湯を注ぐ亭主", "The host pouring hot water for participants at U Share", "row-span-2"],
  [cuhkGroup, "香港中文大学のイベント参加者との集合写真", "Group photo with participants at The Chinese University of Hong Kong", "col-span-2 row-span-2"],
  [ushareFlowers, "ワークショップの机に生けた季節の花", "Seasonal flowers on the workshop tables", "row-span-2"],
  [liliGuests, "お点前を見学する研修の参加者", "Training participants watching the temae", "row-span-2"],
];
const gallery: GalleryImage[] = await Promise.all(
  shots.map(async ([src, ja, en, span]) => {
    const thumb = await getImage({ src, widths: [400, 800], format: "webp" });
    const full = await getImage({ src, widths: [800, 1200, 1600], format: "webp" });
    return {
      thumb: { src: thumb.src, srcset: thumb.srcSet.attribute },
      full: { src: full.src, srcset: full.srcSet.attribute },
      alt: isJa ? ja : en,
      width: src.width,
      height: src.height,
      span,
    };
  }),
);

const h2 = "h-display mt-4 text-4xl md:text-[3.25rem] [:lang(ja)_&]:text-[2.25rem]";
---

<main>
  <!-- ═══ HERO ═══ -->
  <section id="top">
    <div class="container-x grid items-center gap-10 pt-8 pb-16 md:pt-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:pt-16 lg:pb-24">
      <div class="max-w-xl">
        <p class="eyebrow">{o.hero.eyebrow}</p>
        <h1 class="h-display mt-6 text-[clamp(2.6rem,6.2vw,4.75rem)] [:lang(ja)_&]:text-[clamp(2.1rem,5vw,3.6rem)]">
          {o.hero.title[0]}<br />
          <span class="text-matcha italic [:lang(ja)_&]:not-italic">{o.hero.title[1]}</span>
        </h1>
        <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-ink-2">{o.hero.lead}</p>
        <ul class="mt-8 flex flex-wrap gap-2">
          {o.hero.places.map((p) => <li class="rounded-full border border-line bg-paper-2/60 px-3.5 py-1.5 text-sm text-ink-2">{p}</li>)}
        </ul>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#request" class="btn btn-primary">{o.hero.primary} <span aria-hidden="true">→</span></a>
          <a href="#formats" class="btn btn-ghost text-matcha">{o.hero.secondary}</a>
        </div>
      </div>
      <Photo src={ykRoom} alt={o.hero.photoAlt} priority sizes="(min-width: 1024px) 45vw, 100vw" class="aspect-[4/3] rounded-[1.25rem] lg:aspect-[5/4]" />
    </div>
  </section>

  <!-- ═══ FORMATS ═══ -->
  <section id="formats" class="border-y border-line bg-paper-2/70 py-20 md:py-28">
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{o.formats.eyebrow}</p>
        <h2 class={h2}>{o.formats.title}</h2>
        <p class="mt-4 text-lg text-ink-2">{o.formats.lead}</p>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        {
          o.formats.items.map((f, i) => (
            <li class="flex flex-col rounded-2xl border border-line bg-[#fffdf9] p-6 sm:p-8">
              <span class="font-mincho text-lg text-matcha" aria-hidden="true">{marks[i]}</span>
              <h3 class="mt-3 font-display text-[1.75rem] leading-tight font-semibold [:lang(ja)_&]:font-mincho [:lang(ja)_&]:text-[1.3rem]">{f.name}</h3>
              <p class="mt-1 text-sm text-muted">{f.ja}</p>
              <p class="mt-4 leading-relaxed text-ink-2">{f.body}</p>
              <p class="mt-auto border-t border-line pt-4 text-sm text-matcha">{f.fit}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══ USES ═══ -->
  <section id="uses" class="py-20 md:py-28">
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{o.uses.eyebrow}</p>
        <h2 class={h2}>{o.uses.title}</h2>
        <p class="mt-4 text-lg text-ink-2">{o.uses.lead}</p>
      </div>
      <ul class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2" data-reveal>
        {
          o.uses.items.map((u) => (
            <li class="border-t border-line pt-5">
              <h3 class="font-display text-[1.5rem] leading-tight font-semibold [:lang(ja)_&]:font-mincho [:lang(ja)_&]:text-[1.2rem]">{u.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-2">{u.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══ TRACK RECORD ═══ -->
  <section id="work" class="py-20 md:py-28">
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{o.work.eyebrow}</p>
        <h2 class={h2}>{o.work.title}</h2>
      </div>
      <ol class="mt-12 grid gap-5 md:grid-cols-2" data-reveal>
        {
          o.work.items.map((w) => {
            const ph = w.photo ? workPhotos[w.photo] : undefined;
            return (
              <li class="flex flex-col overflow-hidden rounded-2xl border border-line bg-[#fffdf9]">
                {ph ? (
                  <Photo src={ph.src} alt={ph.alt} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[16/10]" position="50% 40%" />
                ) : (
                  <div class="grid aspect-[16/10] place-items-center bg-paper-2 font-mincho text-5xl text-matcha/30" aria-hidden="true">茶</div>
                )}
                <div class="flex flex-1 flex-col p-6">
                  <p class="flex flex-wrap items-baseline gap-x-3 text-sm text-muted tabular-nums">
                    <span class="font-medium text-ink">{w.date}</span>
                    {w.place && <span>{w.place}</span>}
                  </p>
                  <h3 class="mt-2 text-xl font-medium">
                    {w.client}
                    <span class="mt-0.5 block text-base font-normal text-ink-2">{w.title}</span>
                  </h3>
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {w.tags.map((tag) => <li class="rounded-full bg-matcha-soft px-3 py-1 text-xs text-matcha-2">{tag}</li>)}
                  </ul>
                  <p class="mt-3 leading-relaxed text-ink-2">{w.body}</p>
                </div>
              </li>
            );
          })
        }
      </ol>

      <div class="mt-10 grid gap-4 rounded-2xl bg-paper-2 p-6 sm:grid-cols-[12rem_1fr] sm:p-8" data-reveal>
        <h3 class="font-medium">{o.work.backgroundTitle}</h3>
        <ul class="space-y-3">
          {
            o.work.background.map((b) => (
              <li class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-4">
                <span class="text-sm text-muted tabular-nums">{b.date}</span>
                <span>{b.body}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <h3 class="mt-16 text-lg font-medium" data-reveal>{o.work.galleryTitle}</h3>
      <div class="mt-5" data-reveal>
        <Gallery client:visible images={gallery} labels={t.room} />
      </div>
    </div>
  </section>

  <!-- ═══ FLOW ═══ -->
  <section id="flow" class="bg-paper-2/70 py-20 md:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <p class="eyebrow">{o.flow.eyebrow}</p>
        <h2 class={h2}>{o.flow.title}</h2>
        <p class="mt-4 text-ink-2">{o.flow.note}</p>
        <Photo src={ushareTray} alt={isJa ? "盆略点前の道具と干菓子" : "Tray-style tea tools and dry sweets"} sizes="(min-width: 1024px) 35vw, 100vw" class="mt-8 hidden aspect-[4/3] rounded-2xl lg:block" />
      </div>
      <ol class="relative" data-reveal>
        {
          o.flow.steps.map((s, i) => (
            <li class="relative grid grid-cols-[3rem_1fr] gap-4 pb-7 last:pb-0">
              {i < o.flow.steps.length - 1 && <span class="absolute top-12 bottom-0 left-6 w-px bg-line" aria-hidden="true" />}
              <span class="relative grid size-12 place-items-center rounded-full border border-line bg-paper font-mincho text-lg text-matcha">
                {marks[i]}
              </span>
              <div class="pt-2.5">
                <h3 class="text-lg font-medium">{s.title}</h3>
                <p class="mt-1 leading-relaxed text-ink-2">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══ TERMS ═══ -->
  <section id="terms" class="py-20 md:py-28">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.8fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">{o.terms.eyebrow}</p>
        <h2 class={h2}>{o.terms.title}</h2>
      </div>
      <dl class="divide-y divide-line border-y border-line" data-reveal>
        {
          o.terms.items.map((it) => (
            <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-8">
              <dt class="font-medium">{it.k}</dt>
              <dd class="leading-relaxed text-ink-2">{it.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section id="faq" class="py-20 md:py-28">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.8fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">{o.faq.eyebrow}</p>
        <h2 class={h2}>{o.faq.title}</h2>
        <a href={path(lang, "home")} class="link mt-6 inline-block">{o.backHome} →</a>
      </div>
      <div class="divide-y divide-line border-y border-line" data-reveal>
        {
          o.faq.items.map((f) => (
            <details class="group py-1">
              <summary class="flex items-center justify-between gap-6 py-4 text-lg font-medium hover:text-matcha">
                {f.q}
                <span class="faq-icon grid size-8 shrink-0 place-items-center rounded-full border border-line text-xl leading-none text-matcha transition-transform duration-300" aria-hidden="true">+</span>
              </summary>
              <p class="pr-12 pb-5 leading-relaxed text-ink-2">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
  <!-- ═══ REQUEST ═══ -->
  <section id="request" class="border-t border-line bg-paper-2/70 py-20 md:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">{o.form.eyebrow}</p>
        <h2 class={h2}>{o.form.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-2">{o.form.lead}</p>
        <div class="mt-10 border-t border-line pt-6">
          <p class="text-sm text-muted">{t.book.or}</p>
          <ul class="mt-3 space-y-2">
            <li><a class="link" href={instagramUrl} target="_blank" rel="noopener">Instagram · @{site.instagram}</a></li>
            <li><a class="link break-all" href={`mailto:${site.email}`}>{site.email}</a></li>
          </ul>
        </div>
      </div>
      <div class="rounded-3xl border border-line bg-[#fbf8f2] p-5 shadow-[0_10px_40px_rgb(29_35_31/0.06)] sm:p-8" data-reveal>
        <OffsiteRequest client:visible t={o.form} lang={lang} email={site.email} instagramDm={instagramDm} />
      </div>
    </div>
  </section>

</main>
