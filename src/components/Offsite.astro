---
import Photo from "./Photo.astro";
import OffsiteRequest from "./islands/OffsiteRequest";
import { offsite } from "../i18n/offsite";
import { copy, type Lang } from "../i18n/copy";
import { path } from "../i18n/paths";
import { site, instagramUrl, instagramDm } from "../data/site";
import tins from "../assets/images/07-bowl-whisk.jpg";
import kettle from "../assets/images/04c-chabana.jpg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const o = offsite[lang];
const t = copy[lang];
const marks = ["一", "二", "三"];
const h2 = "h-display mt-4 text-4xl md:text-[3.25rem] [:lang(ja)_&]:text-[2.25rem]";
---

<main>
  <!-- ═══ HERO ═══ -->
  <section id="top">
    <div class="container-x grid items-center gap-10 pt-8 pb-16 md:pt-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:pt-16 lg:pb-24">
      <div class="max-w-xl">
        <p class="eyebrow">{o.hero.eyebrow}</p>
        <h1 class="h-display mt-6 text-[clamp(2.6rem,6.2vw,4.75rem)] [:lang(ja)_&]:text-[clamp(2.1rem,5vw,3.6rem)]">
          {o.hero.title[0]}<br />
          <span class="text-matcha italic [:lang(ja)_&]:not-italic">{o.hero.title[1]}</span>
        </h1>
        <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-ink-2">{o.hero.lead}</p>
        <ul class="mt-8 flex flex-wrap gap-2">
          {o.hero.places.map((p) => <li class="rounded-full border border-line bg-paper-2/60 px-3.5 py-1.5 text-sm text-ink-2">{p}</li>)}
        </ul>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#request" class="btn btn-primary">{o.hero.primary} <span aria-hidden="true">→</span></a>
          <a href="#formats" class="btn btn-ghost text-matcha">{o.hero.secondary}</a>
        </div>
      </div>
      <Photo src={tins} alt={o.hero.photoAlt} priority sizes="(min-width: 1024px) 45vw, 100vw" class="aspect-[4/3] rounded-[1.25rem] lg:aspect-[4/5]" />
    </div>
  </section>

  <!-- ═══ FORMATS ═══ -->
  <section id="formats" class="border-y border-line bg-paper-2/70 py-20 md:py-28">
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{o.formats.eyebrow}</p>
        <h2 class={h2}>{o.formats.title}</h2>
        <p class="mt-4 text-lg text-ink-2">{o.formats.lead}</p>
      </div>
      <ul class="mt-12 grid gap-5 md:grid-cols-3" data-reveal>
        {
          o.formats.items.map((f, i) => (
            <li class="flex flex-col rounded-2xl border border-line bg-[#fffdf9] p-6 sm:p-8">
              <span class="font-mincho text-lg text-matcha" aria-hidden="true">{marks[i]}</span>
              <h3 class="mt-3 font-display text-[1.9rem] leading-tight font-semibold [:lang(ja)_&]:font-mincho [:lang(ja)_&]:text-[1.4rem]">{f.name}</h3>
              <p class="mt-1 text-sm text-muted">{f.ja}</p>
              <p class="mt-4 leading-relaxed text-ink-2">{f.body}</p>
              <p class="mt-auto border-t border-line pt-4 text-sm text-matcha">{f.fit}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══ TRACK RECORD ═══ -->
  <section id="work" class="py-20 md:py-28">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.8fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">{o.work.eyebrow}</p>
        <h2 class={h2}>{o.work.title}</h2>
      </div>
      <ol class="divide-y divide-line border-y border-line" data-reveal>
        {
          o.work.items.map((w) => (
            <li class="grid gap-3 py-6 sm:grid-cols-[8rem_1fr] sm:gap-8">
              <p class="text-sm text-muted tabular-nums">
                <span class="block font-medium text-ink">{w.date}</span>
                {w.place}
              </p>
              <div>
                <h3 class="text-xl font-medium">{w.title}</h3>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {w.tags.map((tag) => <li class="rounded-full bg-matcha-soft px-3 py-1 text-xs text-matcha-2">{tag}</li>)}
                </ul>
                <p class="mt-3 leading-relaxed text-ink-2">{w.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══ FLOW ═══ -->
  <section id="flow" class="bg-paper-2/70 py-20 md:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <p class="eyebrow">{o.flow.eyebrow}</p>
        <h2 class={h2}>{o.flow.title}</h2>
        <p class="mt-4 text-ink-2">{o.flow.note}</p>
        <Photo src={kettle} alt={t.room.photos.kettle} sizes="(min-width: 1024px) 35vw, 100vw" class="mt-8 hidden aspect-[4/3] rounded-2xl lg:block" />
      </div>
      <ol class="relative" data-reveal>
        {
          o.flow.steps.map((s, i) => (
            <li class="relative grid grid-cols-[4rem_1fr] gap-4 pb-8 last:pb-0">
              {i < o.flow.steps.length - 1 && <span class="absolute top-14 bottom-0 left-8 w-px bg-line" aria-hidden="true" />}
              <span class="relative grid size-16 place-items-center rounded-full border border-line bg-paper text-center leading-none">
                <span>
                  <span class="block font-display text-xl font-semibold text-matcha tabular-nums">{s.min}</span>
                  <span class="text-[0.6875rem] text-muted">{o.flow.minutes}</span>
                </span>
              </span>
              <div class="pt-3">
                <h3 class="text-lg font-medium">{s.title}</h3>
                <p class="mt-1 leading-relaxed text-ink-2">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══ TERMS ═══ -->
  <section id="terms" class="py-20 md:py-28">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.8fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">{o.terms.eyebrow}</p>
        <h2 class={h2}>{o.terms.title}</h2>
      </div>
      <dl class="divide-y divide-line border-y border-line" data-reveal>
        {
          o.terms.items.map((it) => (
            <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-8">
              <dt class="font-medium">{it.k}</dt>
              <dd class="leading-relaxed text-ink-2">{it.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section id="faq" class="py-20 md:py-28">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.8fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">{o.faq.eyebrow}</p>
        <h2 class={h2}>{o.faq.title}</h2>
        <a href={path(lang, "home")} class="link mt-6 inline-block">{o.backHome} →</a>
      </div>
      <div class="divide-y divide-line border-y border-line" data-reveal>
        {
          o.faq.items.map((f) => (
            <details class="group py-1">
              <summary class="flex items-center justify-between gap-6 py-4 text-lg font-medium hover:text-matcha">
                {f.q}
                <span class="faq-icon grid size-8 shrink-0 place-items-center rounded-full border border-line text-xl leading-none text-matcha transition-transform duration-300" aria-hidden="true">+</span>
              </summary>
              <p class="pr-12 pb-5 leading-relaxed text-ink-2">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
  <!-- ═══ REQUEST ═══ -->
  <section id="request" class="border-t border-line bg-paper-2/70 py-20 md:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">{o.form.eyebrow}</p>
        <h2 class={h2}>{o.form.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-2">{o.form.lead}</p>
        <div class="mt-10 border-t border-line pt-6">
          <p class="text-sm text-muted">{t.book.or}</p>
          <ul class="mt-3 space-y-2">
            <li><a class="link" href={instagramUrl} target="_blank" rel="noopener">Instagram · @{site.instagram}</a></li>
            <li><a class="link break-all" href={`mailto:${site.email}`}>{site.email}</a></li>
          </ul>
        </div>
      </div>
      <div class="rounded-3xl border border-line bg-[#fbf8f2] p-5 shadow-[0_10px_40px_rgb(29_35_31/0.06)] sm:p-8" data-reveal>
        <OffsiteRequest client:visible t={o.form} lang={lang} email={site.email} instagramDm={instagramDm} />
      </div>
    </div>
  </section>

</main>
