---
import Photo from "./Photo.astro";
import { copy, type Lang } from "../i18n/copy";
import { path } from "../i18n/paths";
import room from "../assets/images/09-ippuku.jpg";
import host from "../assets/images/moment-02.jpg";
import kettle from "../assets/images/04c-chabana.jpg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const a = t.about;
const home = path(lang, "home");
---

<main>
  <section class="container-x pt-12 pb-12 md:pt-20 md:pb-16">
    <p class="eyebrow">{a.eyebrow}</p>
    <h1 class="h-display mt-6 text-[clamp(3rem,8vw,6rem)] [:lang(ja)_&]:text-[clamp(2.4rem,6vw,4.25rem)]">
      {a.title[0]} <span class="text-matcha italic [:lang(ja)_&]:not-italic">{a.title[1]}</span>
    </h1>
    <p class="mt-4 font-mincho tracking-[0.3em] text-muted [:lang(ja)_&]:font-display [:lang(ja)_&]:tracking-[0.06em] [:lang(ja)_&]:italic" lang={lang === "ja" ? "en" : "ja"}>
      {a.sub}
    </p>
  </section>

  <div class="container-x">
    <Photo src={room} alt={a.photoAlt} priority sizes="(min-width: 1216px) 1150px, 100vw" class="aspect-[4/3] rounded-2xl md:aspect-[21/9]" position="50% 55%" />
  </div>

  <section class="container-x grid gap-12 py-16 md:py-24 lg:grid-cols-[1fr_2fr] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <dl class="divide-y divide-line border-y border-line">
        {
          a.facts.map((f) => (
            <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
              <dt class="text-sm text-muted">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
      <Photo src={kettle} alt={t.room.photos.kettle} sizes="(min-width: 1024px) 30vw, 100vw" class="mt-8 hidden aspect-[4/5] rounded-2xl lg:block" />
    </div>

    <div class="max-w-[40rem] space-y-6 text-lg leading-[1.95] [:lang(ja)_&]:text-[1.0625rem] [:lang(ja)_&]:leading-[2.2]">
      {
        a.paragraphs.map((p, i) => (
          <p
            class:list={[
              i === 0 &&
                "first-letter:float-left first-letter:mt-1 first-letter:mr-3 first-letter:font-display first-letter:text-[4.2rem] first-letter:leading-[0.8] first-letter:text-matcha [:lang(ja)_&]:first-letter:font-mincho [:lang(ja)_&]:first-letter:text-[3.2rem]",
            ]}
          >
            {p}
          </p>
        ))
      }
    </div>
  </section>

  <section class="bg-matcha text-paper">
    <div class="container-x grid items-center gap-10 py-16 md:grid-cols-[1fr_1.2fr] md:py-20 lg:gap-20">
      <Photo src={host} alt={a.photo2Alt} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/5] rounded-2xl md:order-2" />
      <div>
        <p class="font-display text-[clamp(1.8rem,3.4vw,2.75rem)] leading-tight [:lang(ja)_&]:font-mincho [:lang(ja)_&]:text-[clamp(1.4rem,2.6vw,2rem)] [:lang(ja)_&]:leading-relaxed">
          {a.closing}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`${home}#book`} class="btn btn-light">{t.hero.primary} <span aria-hidden="true">→</span></a>
          <a href={`${home}#plans`} class="btn btn-outline-light">{t.hero.secondary}</a>
        </div>
      </div>
    </div>
  </section>
</main>
