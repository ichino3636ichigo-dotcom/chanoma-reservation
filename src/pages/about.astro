---
import Layout from "../layouts/Layout.astro";
import Photo from "../components/Photo.astro";
import { url } from "../data/site";

import ippuku from "../assets/images/09-ippuku.jpg";
import chabana from "../assets/images/04c-chabana.jpg";

const storyEn = [
  "I learned the way of tea from my grandmother — a Jun-kyōju of the Urasenke school, holding its highest rank of certified teacher. Our tea room was tucked away at the back of our family home, a space that had stood for over a century. Spending time there from an early age made tea ceremony feel like a natural part of my life.",
  "For four years, I worked as a tea ceremony instructor, welcoming groups of visitors from around the world. The form of tea ceremony was there, but I began to feel that something essential was being lost in a crowded setting—the quietness, the subtle care for each guest, and the intimate connection between host and guest. That feeling led me to create Chanoma.",
  "At the heart of tea ceremony is simply being present: with the guest before you, with the season, and with the bowl of matcha in your hands. From this attentiveness emerges the spirit of hospitality. For four hundred years, the traditions of tea have been refined into a way of welcoming guests with thoughtfulness and care. Yet the heart of tea cannot always be conveyed through words or explanations. At Chanoma, we offer a small, intimate space where you can slow down, sit together, and experience the spirit of tea for yourself.",
];

const storyJa = [
  "茶道を学んだのは、祖母からでした。稽古の場は家の奥にある築百年の茶室。幼い頃からあの部屋で過ごした日々が、茶道を身近に感じさせてくれました。",
  "四年間、多くの観光客を一度に迎える茶道体験の場で、講師を続けました。形はあっても、本当に伝えたいこと——静けさ、細やかな心くばり、亭主と客との近さ——は、大勢の中ではこぼれ落ちてしまう。そう感じて、茶乃間を始めました。",
  "茶道の本質は、目の前のお客様、季節、抹茶に向き合うこと。それがおもてなしにつながる一連の流れだと思っています。四百年をかけて研ぎ澄まされた、客人を迎えるための型。説明だけでは届かない茶道の心を、小さな間で、ゆっくり、座って体感していただく場を茶乃間がご用意します。",
];
---

<Layout
  title="About — chanoma"
  description="Where it began. The story behind chanoma, a tea room on the third floor of a Kyoto flower shop."
>
  <header class="fixed inset-x-0 top-0 z-40 flex items-center justify-between px-gut py-[26px] text-white mix-blend-difference">
    <a href={url("/")} class="text-[1.05rem] tracking-[0.32em] lowercase">chanoma</a>
    <a href={url("/")} class="group inline-flex items-center gap-[0.7em] text-[0.66rem] tracking-[0.34em] uppercase">
      <span class="inline-block transition-transform duration-800 ease-breath group-hover:-translate-x-[5px]" aria-hidden="true">←</span>
      Home
    </a>
  </header>

  <main>
    <section class="pt-[clamp(9rem,20vh,15rem)] pb-[clamp(4rem,9vh,7rem)]">
      <div class="wrap">
        <p class="label" data-r>About · 茶乃間について</p>
        <h1 class="mt-6 text-[clamp(2.6rem,7vw,6rem)] leading-[1.04] font-light tracking-[-0.01em]" data-r>
          Where it <em>began.</em>
        </h1>
        <p class="mt-6 font-jp text-[clamp(1rem,1.6vw,1.4rem)] font-light tracking-[0.5em] text-bronze" data-r>はじまりの話</p>
      </div>
    </section>

    <section class="pb-[clamp(5rem,12vh,10rem)]">
      <div class="wrap grid-12">
        <Photo
          src={ippuku}
          alt="The quiet tatami room with a round window and two cushions"
          sizes="(min-width: 880px) 75vw, 100vw"
          class="col-span-full aspect-[4/3] md:col-[2/span_9] md:aspect-video"
          data-r
        />
      </div>
    </section>

    <section class="pb-[clamp(7rem,16vh,13rem)]">
      <div class="wrap grid-12">
        <div class="col-span-full space-y-6 min-[881px]:col-[1/span_7] min-[981px]:col-[2/span_6]" data-r>
          {
            storyEn.map((p, i) => (
              <p
                class:list={[
                  "text-[clamp(1.05rem,1.3vw,1.3rem)] leading-[1.95]",
                  i === 0 &&
                    "first-letter:float-left first-letter:pt-[0.06em] first-letter:pr-[0.12em] first-letter:text-[3.2em] first-letter:leading-[0.82] first-letter:text-bronze first-letter:italic",
                ]}
              >
                {p}
              </p>
            ))
          }
        </div>
        <div class="col-span-full mt-14 space-y-6 font-jp font-light min-[881px]:col-[8/span_5] min-[881px]:mt-0 min-[981px]:col-[9/span_4]" data-r>
          <span class="block font-serif text-[0.62rem] tracking-[0.34em] text-ink-38 uppercase">日本語</span>
          {storyJa.map((p) => <p class="text-[0.98rem] leading-[2.15] tracking-[0.02em] text-ink-60">{p}</p>)}
        </div>
      </div>
    </section>

    <section class="pb-[clamp(6rem,14vh,11rem)]">
      <div class="wrap grid-12">
        <Photo
          src={chabana}
          alt="An iron kettle steaming on the brazier"
          class="col-span-full aspect-[4/5] md:col-[6/span_6] md:aspect-[3/4]"
          data-r
        />
      </div>
    </section>

    <section class="pb-[clamp(7rem,16vh,12rem)]">
      <div class="wrap grid-12">
        <p class="col-span-full text-[clamp(1.6rem,3.2vw,2.8rem)] leading-[1.3] font-light md:col-[2/span_7]" data-r>
          Sessions are by reservation only —<br /><em class="text-ink-60">up to 4 guests, fully in English.</em>
        </p>
        <div class="col-span-full mt-12 flex flex-wrap gap-9 md:col-[2/span_8]" data-r>
          {
            [
              { label: "See the plans", href: url("/#plans") },
              { label: "How to reserve", href: url("/#reserve") },
            ].map((l) => (
              <a
                href={l.href}
                class="border-b border-hair pb-[0.5em] text-[0.72rem] tracking-[0.3em] text-bronze uppercase transition-colors duration-800 ease-breath hover:border-bronze"
              >
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
