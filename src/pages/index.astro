---
import Layout from "../layouts/Layout.astro";
import Photo from "../components/Photo.astro";
import Nav from "../components/Nav";
import Hero from "../components/Hero";
import TeaRoom from "../components/TeaRoom";
import BowlRipple from "../components/BowlRipple";
import Hour from "../components/Hour";
import { site, facts, plans, house, chapters, url } from "../data/site";

import river from "../assets/images/01-takase-river-dusk.jpg";
import tatami from "../assets/images/04a-tatami.jpg";
import tokonoma from "../assets/images/04b-tokonoma.jpg";
import chabana from "../assets/images/04c-chabana.jpg";
import bowl from "../assets/images/07-bowl-whisk.jpg";
import moment1 from "../assets/images/moment-01.jpg";
import moment2 from "../assets/images/moment-02.jpg";

const navChapters = chapters.map((c) => ({ ...c, href: url(c.href) }));
---

<Layout
  title="chanoma — Tea Ceremony & Matcha Experience in Kyoto"
  description="A tea ceremony and matcha tasting in a tatami room on the 3rd floor of Nishimura Flower Shop, Kyoto. Small groups, in English, by reservation only."
>
  <a
    href="#reserve"
    class="absolute -left-[9999px] z-99 focus:top-5 focus:left-(--gut) focus:border focus:border-bronze focus:bg-paper focus:px-[18px] focus:py-3"
  >
    Skip to reservation
  </a>

  <Nav client:load chapters={navChapters} home={url("/")} />
  <Hour client:idle />

  <main id="top">
    <!-- ═══ ARRIVAL ═══ -->
    <Hero client:load>
      <Photo slot="image" src={river} alt="The Takase River in Kyoto at dusk" sizes="100vw" priority class="absolute inset-0" />
      <h1 class="text-[clamp(2.6rem,7vw,7rem)] leading-[1.02] font-light tracking-[-0.015em] [text-shadow:0_2px_28px_rgb(12_10_8/.55)]">
        Authentic Matcha<br />Experience in Kyoto
      </h1>
      <p class="mt-6 text-[0.7rem] tracking-[0.44em] text-paper/90 uppercase [text-shadow:0_1px_10px_rgb(12_10_8/.7)]">
        Tea ceremony &amp; matcha tasting · {site.place}
      </p>
      <div class="mt-7 flex flex-wrap gap-2.5">
        {
          facts.map((f) => (
            <span class="rounded-full border border-paper/40 px-[15px] py-2 text-[0.64rem] tracking-[0.2em] whitespace-nowrap text-paper/90 uppercase">
              {f}
            </span>
          ))
        }
      </div>
    </Hero>

    <!-- ═══ 一 · INTRO ═══ -->
    <section id="intro" aria-label="Introduction" class="section-y">
      <div class="wrap grid-12 items-start">
        <div class="col-span-full md:col-span-3" data-r>
          <p class="mark">一</p>
          <p class="label mt-4">What it is</p>
        </div>
        <div class="col-span-full md:col-[4/span_7]" data-r>
          <p class="lede max-w-[30ch] text-[clamp(1.3rem,2vw,1.8rem)] text-ink">
            A tea ceremony experience in a traditional tatami room, on the third floor of Nishimura Flower Shop in Kyoto —
            where tea ceremony and ikebana naturally meet.
          </p>
          <p class="lede mt-6 text-[1.05rem]">
            Sessions are small (up to 4 guests) and fully conducted in English. By reservation only — no walk-ins.
          </p>
          <a class="btn mt-10" href={url("/about")}>Read our story <span class="arw" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- ═══ 二 · THE TEA ROOM ═══ -->
    <TeaRoom client:visible>
      <Photo slot="layer0" src={tatami} alt="The building seen through willow branches, the tea room window on the upper floor" sizes="100vw" class="absolute inset-0" />
      <Photo slot="layer1" src={tokonoma} alt="The tatami room with its round window and an iron kettle" sizes="100vw" class="absolute inset-0" />
      <Photo slot="layer2" src={chabana} alt="An iron kettle steaming on the brazier" sizes="100vw" class="absolute inset-0" />
      <p class="max-w-[min(38ch,60vw)] justify-self-end text-right text-[clamp(1.9rem,4.2vw,4.2rem)] leading-[1.24] font-light [text-shadow:0_1px_40px_rgb(43_41_38/.4)]">
        A traditional tatami room,<br />on the third floor<br /><em class="text-paper/65">above the flower shop.</em>
      </p>
    </TeaRoom>

    <!-- ═══ 三 · PREPARING MATCHA ═══ -->
    <section id="matcha" aria-label="Preparing matcha" class="section-y">
      <div class="wrap grid-12">
        <Photo src={bowl} alt="Matcha tins and bamboo whisks" class="col-span-full aspect-[4/5] md:col-[2/span_4]" data-r>
          <div class="steam pointer-events-none absolute inset-0 z-1 overflow-hidden mix-blend-screen" aria-hidden="true">
            <i></i><i></i><i></i>
          </div>
          <BowlRipple client:visible />
        </Photo>
        <div class="col-span-full mt-10 self-center md:col-[7/span_4] md:mt-0" data-r>
          <p class="mark">三</p>
          <p class="label mt-4">Our recommendation</p>
          <p class="lede mt-6">
            If it's your first visit, we recommend <b class="font-medium text-ink">Signature</b> — the full experience in one
            sitting. The ceremony, whisking your own bowl, and a tasting of three matcha grades side by side.
          </p>
          <a class="btn mt-9" href="#plans">See Signature <span class="arw" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- ═══ 四 · THE PLANS ═══ -->
    <section id="plans" aria-label="The plans" class="section-y">
      <div class="wrap">
        <div class="mb-[clamp(4rem,9vh,7rem)]" data-r>
          <p class="mark">四</p>
          <h2 class="mt-4 text-[clamp(2rem,4vw,3.6rem)] leading-[1.06] font-light tracking-[-0.012em]">The plans</h2>
          <p class="lede mt-6 max-w-[36ch]">
            Three sessions to choose from. All are by reservation, for up to 4 guests, and fully conducted in English.
          </p>
        </div>

        <div data-r>
          {
            plans.map((p) => (
              <article class="grid grid-cols-1 items-baseline gap-4 border-t border-hair py-8 last:border-b md:grid-cols-12 md:gap-(--gut) md:py-[2.4rem]">
                <div class="md:col-span-4">
                  <h3 class="text-[clamp(1.7rem,3vw,2.6rem)] leading-[1.1] font-light">
                    {p.name}
                    {p.ja && <span class="ml-2 font-jp text-[0.6em] font-extralight text-ink-38">{p.ja}</span>}
                  </h3>
                  <span class="mt-2 block text-[1.1rem] tracking-[0.06em] text-bronze tabular-nums">{p.price}</span>
                </div>
                <p class="text-[clamp(1rem,1.2vw,1.2rem)] leading-[1.95] text-ink-60 md:col-[5/span_6]">{p.what}</p>
                <p class="text-[0.66rem] leading-[1.9] tracking-[0.22em] text-ink-38 uppercase md:col-[11/span_2] md:text-right">
                  {p.duration}
                  <br />
                  per person
                </p>
              </article>
            ))
          }
        </div>

        <div class="mt-[clamp(3rem,7vh,5rem)] grid-12" data-r>
          <dl class="col-span-full grid grid-cols-[1fr_1.4fr] gap-x-8 gap-y-2 border-t border-hair pt-6 md:col-[8/span_4]">
            {
              house.map((h) => (
                <>
                  <dt class="pt-[0.42rem] text-[0.62rem] tracking-[0.32em] text-ink-38 uppercase">{h.k}</dt>
                  <dd class="leading-[1.8]" set:html={h.v} />
                </>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- ═══ 五 · MOMENTS ═══ -->
    <section id="moments" aria-label="Moments" class="section-y">
      <div class="wrap mb-[clamp(3rem,7vh,6rem)]">
        <p class="mark" data-r>五</p>
        <p class="label mt-4" data-r>Moments — scenes from a session</p>
      </div>
      <div class="wrap grid-12 items-center">
        <Photo src={moment1} alt="The host serving matcha to guests in the tatami room" class="col-span-full aspect-[4/5] md:col-[2/span_4]" data-r />
        <Photo
          src={moment2}
          alt="The host in kimono outside Nishimura Flower Shop"
          class="col-span-full mt-8 aspect-[4/5] md:col-[8/span_4] md:mt-[12vh] md:aspect-[3/4]"
          data-r
        />
      </div>
    </section>

    <!-- ═══ 六 · RESERVATION ═══ -->
    <section id="reserve" aria-label="Reservation" class="pt-[clamp(9rem,20vh,17rem)] pb-[clamp(6rem,12vh,10rem)]">
      <div class="wrap grid-12">
        <h2 class="col-span-full text-[clamp(2.4rem,5.6vw,5rem)] leading-[1.1] font-light md:col-span-6" data-r>
          <span class="mark mb-6 block">六</span>Reservations
        </h2>
        <div class="col-span-full mt-14 self-end md:col-[8/span_4] md:mt-0" data-r>
          <p class="mb-6 text-[0.66rem] tracking-[0.4em] text-bronze uppercase">By reservation only · No walk-ins</p>
          <p class="lede mb-7 max-w-[32ch]">Book through Instagram or email, and we'll confirm your session time.</p>
          {
            [
              { label: "Instagram", detail: `@${site.instagram}`, href: `https://instagram.com/${site.instagram}`, ext: true },
              { label: "Email", detail: site.email, href: `mailto:${site.email}`, ext: false },
            ].map((l) => (
              <a
                href={l.href}
                {...(l.ext ? { target: "_blank", rel: "noopener" } : {})}
                class="flex items-baseline justify-between gap-8 border-b border-hair py-6 text-[1.35rem] transition-[color,padding] duration-900 ease-breath first-of-type:border-t hover:pl-[0.6em] hover:text-bronze focus-visible:pl-[0.6em] focus-visible:text-bronze"
              >
                {l.label}
                <span class="truncate text-[0.6rem] tracking-[0.32em] text-ink-38 uppercase">{l.detail}</span>
              </a>
            ))
          }
        </div>
      </div>
      <div class="wrap mt-[clamp(5rem,10vh,8rem)] grid-12" data-r>
        <p class="col-span-full leading-loose text-ink-38 md:col-[8/span_4]">
          Up to 4 guests per session · Fully conducted in English · {site.place}, {site.city}.
        </p>
      </div>
    </section>
  </main>

  <a
    slot="footer"
    href={url("/about")}
    class="inline-flex items-center gap-[0.6em] text-[0.66rem] tracking-[0.34em] text-bronze uppercase"
  >
    About chanoma <span class="arw" aria-hidden="true">→</span>
  </a>
</Layout>
